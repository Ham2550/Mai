//@version=5
strategy("MTF Stoch RSI Long Strategy (%K & %D)", shorttitle="แรงตลาดกังๆ", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ==========================================
// 1. ตั้งค่าพารามิเตอร์ Stochastic RSI
// ==========================================
rsiLength   = input.int(14, title="RSI Length", group="Stoch RSI Settings")
stochLength = input.int(14, title="Stochastic Length", group="Stoch RSI Settings")
kSmooth     = input.int(3,  title="%K Smoothing", group="Stoch RSI Settings")
dSmooth     = input.int(3,  title="%D Smoothing", group="Stoch RSI Settings")

// ==========================================
// 2. ฟังก์ชันคำนวณ %K และ %D ของ Stoch RSI
// ==========================================
f_stochRSI() =>
    rsiVal = ta.rsi(close, rsiLength)
    kVal   = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, stochLength), kSmooth)
    dVal   = ta.sma(kVal, dSmooth)
    [kVal, dVal]

// ==========================================
// 3. ดึงค่า %K และ %D จาก 3 ไทม์เฟรม (1H, 4H, 1D)
// ==========================================
[k_1h, d_1h] = request.security(syminfo.tickerid, "60",  f_stochRSI())
[k_4h, d_4h] = request.security(syminfo.tickerid, "240", f_stochRSI())
[k_1d, d_1d] = request.security(syminfo.tickerid, "D",   f_stochRSI())

// ==========================================
// 4. นับจำนวนไทม์เฟรมที่เข้าเงื่อนไขต่างๆ
// ==========================================
// เงื่อนไขฝั่งซื้อ (Oversold)
count_BB  = ((k_1h < 3  and d_1h<15)? 1 : 0) + ((k_4h < 3  and d_4h<15)? 1 : 0) + ((k_1d < 3  and d_1d<15)? 1 : 0)
count_GB  = ((k_1h < 5 and d_1h<5)? 1 : 0) + ((k_4h < 5 and d_4h<5)? 1 : 0) + ((k_1d < 5  and d_1d<5)? 1 : 0)
count_NB  = (k_1h < 7  ? 1 : 0) + (k_4h < 7  ? 1 : 0) + (k_1d < 7  ? 1 : 0)

// เงื่อนไขฝั่งขาย/ปิดสถานะ (Overbought)
count_BS = ((k_1h > 97 and d_1h>85)? 1 : 0) + ((k_4h >97 and d_4h>85)? 1 : 0) + ((k_1d >97 and d_1d>85)? 1 : 0)
count_GS= ((k_1h > 95 and d_1h>95)? 1 : 0) + ((k_4h >95 and d_4h>95)? 1 : 0) + ((k_1d >95 and d_1d>95)? 1 : 0)
count_NS = (k_1h > 93 ? 1 : 0) + (k_4h > 93 ? 1 : 0) + (k_1d > 93 ? 1 : 0)

// ==========================================
// 5. คัดกรองสัญญาณ (Priority Filtering ไม่ให้ซ้อนทับกัน)
// ==========================================
// สัญญาณสีทอง (สูงสุด): ครบทั้ง 3 ไทม์เฟรม (< 5 หรือ > 95)
gold_Buy   = (count_GB >=2)
gold_Sell  = (count_GS >= 2)

// สัญญาณสีฟ้า: อย่างน้อย 2 ไทม์เฟรม (< 3 หรือ > 97) และไม่ซ้ำกับสีทอง
blue_Buy   = (count_BB>= 2) and not gold_Buy
blue_Sell  = (count_BS>= 2) and not gold_Sell

// สัญญาณสีเขียว/แดง: อย่างน้อย 2 ไทม์เฟรม (< 7 หรือ > 93) และไม่ซ้ำกับสีทองหรือสีฟ้า
green_Buy  = (count_NB >= 2) and not gold_Buy and not blue_Buy
red_Sell   = (count_NS >= 2) and not gold_Sell and not blue_Sell

// ==========================================
// 6. แสดงผลลูกศรขนาดเล็ก (ไม่มีข้อความ ไม่ไฮไลต์จอ)
// ==========================================
// ลูกศรขาเข้า Long (ชี้ขึ้น ใต้แท่งเทียน)
plotshape(gold_Buy,  style=shape.diamond, location=location.belowbar, color=#FFD700, size=size.small, title="Gold Buy (<5 All TFs)")
plotshape(blue_Buy,  style=shape.arrowup, location=location.belowbar, color=#00BCD4, size=size.large, title="Blue Buy (<3 Two TFs)")
plotshape(green_Buy, style=shape.arrowup, location=location.belowbar, color=#00E676, size=size.small, title="Green Buy (<7 Two TFs)")

// ลูกศรขาออก/ปิด Long (ชี้ลง เหนือแท่งเทียน)
plotshape(gold_Sell, style=shape.diamond, location=location.abovebar, color=#FFD700, size=size.small, title="Gold Sell (>95 All TFs)")
plotshape(blue_Sell, style=shape.arrowdown, location=location.abovebar, color=#00BCD4, size=size.large, title="Blue Sell (>97 Two TFs)")
plotshape(red_Sell,  style=shape.arrowdown, location=location.abovebar, color=#FF5252, size=size.small, title="Red Sell (>92 Two TFs)")

[k_15m, d_15m] = request.security(syminfo.tickerid, "15", f_stochRSI())
Count_SB=  (k_15m > 88  ? 1 : 0) + (k_4h> 99  ? 1 : 0) + (k_1d >99  ? 1 : 0) + (k_1h > 97 ? 1 : 0)
Count_SS= (k_15m < 12  ? 1 : 0) + (k_4h < 1  ? 1 : 0) + (k_1d < 1  ? 1 : 0) + (k_1h < 3 ? 1 : 0)
Short_Sell =(Count_SS>=2)
Short_Buy=(Count_SB>=2)

plotshape(Short_Buy,  style=shape.xcross, location=location.abovebar, color=#FFD700, size=size.small, title="Gold Buy (<5 All TFs)")

plotshape(Short_Sell,  style=shape.xcross, location=location.belowbar, color=#FFD700, size=size.small, title="Gold Sell (<5 All TFs)")
