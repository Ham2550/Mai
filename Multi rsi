//@version=5
indicator("MTF Stochastic RSI Matrix & Webhook Alerts", overlay=true)

// --- INPUTS ---
stochLen = input.int(14, title="Stochastic Length")
rsiLen   = input.int(14, title="RSI Length")
kSmooth  = input.int(3,  title="K Smoothing")
dSmooth  = input.int(3,  title="D Smoothing")

// --- STOCHASTIC RSI CALCULATION FUNCTION ---
f_calcStochRsi() =>
    v_rsi = ta.rsi(close, rsiLen)
    v_rsi_low  = ta.lowest(v_rsi, stochLen)
    v_rsi_high = ta.highest(v_rsi, stochLen)
    v_stoch    = (v_rsi_high - v_rsi_low) == 0 ? 0 : (v_rsi - v_rsi_low) / (v_rsi_high - v_rsi_low) * 100
    v_k = ta.sma(v_stoch, kSmooth)
    v_d = ta.sma(v_k, dSmooth)
    [v_k, v_d]

// --- FETCH DATA FOR 4 TIMEFRAMES (15m, 1h, 4h, 1D) ---
[k_15m, d_15m] = request.security(syminfo.tickerid, "15",  f_calcStochRsi(), barmerge.gaps_off, barmerge.lookahead_off)
[k_1h,  d_1h]  = request.security(syminfo.tickerid, "60",  f_calcStochRsi(), barmerge.gaps_off, barmerge.lookahead_off)
[k_4h,  d_4h]  = request.security(syminfo.tickerid, "240", f_calcStochRsi(), barmerge.gaps_off, barmerge.lookahead_off)
[k_1d,  d_1d]  = request.security(syminfo.tickerid, "D",   f_calcStochRsi(), barmerge.gaps_off, barmerge.lookahead_off)

// ==========================================
// --- EVALUATE SETUPS ---
// ==========================================

// 1. ระดับ 1 (L1 - สีเหลืองส้ม)
buy_cond_1  = (k_1h <= 7  and k_4h <= 4)  or (k_1d <= 2  and k_4h <= 4)  or (k_1d <= 2  and k_1h <= 7)
sell_cond_1 = (k_1h >= 93 and k_4h >= 96) or (k_1d >= 98 and k_4h >= 96) or (k_1d >= 98 and k_1h >= 93)

// 2. ระดับ 2 (L2 - สีเหลือง)
buy_cond_2  = (k_1h <= 4  and k_4h <= 4  and d_1h <= 15 and d_4h <= 15) or (k_1d <= 2  and k_4h <= 4  and d_1d <= 15 and d_4h <= 15) or (k_1h <= 4  and k_1d <= 2  and d_1h <= 15 and d_1d <= 15)
sell_cond_2 = (k_1h >= 96 and k_4h >= 96 and d_1h >= 85 and d_4h >= 85) or (k_1d >= 98 and k_4h >= 96 and d_1d >= 85 and d_4h >= 85) or (k_1h >= 96 and k_1d >= 98 and d_1h >= 85 and d_1d >= 85)

// 3. ระดับ 3 (L3 - สีเขียว)
buy_cond_3  = (k_1h <= 2  and k_4h <= 2  and d_1h <= 5  and d_4h <= 5)  or (k_1d <= 1  and k_4h <= 2  and d_1d <= 5  and d_4h <= 5)  or (k_1h <= 2  and k_1d <= 1  and d_1h <= 5  and d_1d <= 5)
sell_cond_3 = (k_1h >= 97 and k_4h >= 98 and d_1h >= 95 and d_4h >= 95) or (k_1d >= 99 and k_4h >= 98 and d_1d >= 95 and d_4h >= 95) or (k_1h >= 97 and k_1d >= 99 and d_1h >= 95 and d_1d >= 95)

// 4. เงื่อนไขพิเศษ (Extreme Alert)
any_extreme_buy  = (k_1h <= 1  and d_1h <= 5)  or (k_4h <= 1  and d_4h <= 5)  or (k_1d <= 1  and d_1d <= 5)
any_extreme_sell = (k_1h >= 99 and d_1h >= 95) or (k_4h >= 99 and d_4h >= 95) or (k_1d >= 99 and d_1d >= 95)

// ==========================================
// --- DETERMINE DISPLAY STATUS ---
// ==========================================
string setup_text   = "NEUTRAL"
color  setup_color  = color.gray
color  conf_color   = color.gray
string conf_text    = "-"
string extreme_text = "NORMAL"
color  extreme_col  = color.gray

if sell_cond_3
    setup_text  := "SELL SETUP"
    setup_color := color.rgb(255, 105, 180)
    conf_color  := color.green
    conf_text   := "High (L3)"
else if sell_cond_2
    setup_text  := "SELL SETUP"
    setup_color := color.rgb(255, 105, 180)
    conf_color  := color.yellow
    conf_text   := "Medium (L2)"
else if sell_cond_1
    setup_text  := "SELL SETUP"
    setup_color := color.rgb(255, 105, 180)
    conf_color  := color.orange
    conf_text   := "Low (L1)"
else if buy_cond_3
    setup_text  := "BUY SETUP"
    setup_color := color.rgb(0, 191, 255)
    conf_color  := color.green
    conf_text   := "High (L3)"
else if buy_cond_2
    setup_text  := "BUY SETUP"
    setup_color := color.rgb(0, 191, 255)
    conf_color  := color.yellow
    conf_text   := "Medium (L2)"
else if buy_cond_1
    setup_text  := "BUY SETUP"
    setup_color := color.rgb(0, 191, 255)
    conf_color  := color.orange
    conf_text   := "Low (L1)"

if any_extreme_sell
    extreme_text := "EXTREME SELL"
    extreme_col  := color.rgb(255, 0, 0)
else if any_extreme_buy
    extreme_text := "EXTREME BUY"
    extreme_col  := color.rgb(0, 255, 0)

